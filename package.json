{
  "name": "opsv-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Öppen svensk plattform för säkra AI-, kod- och UI-utmaningar.",
  "license": "MIT",
  "projectStartDate": "2026-08-24",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "npm run build:agent-mcp",
    "predev": "npm run build:agent-mcp",
    "build:agent-mcp": "esbuild tools/opsv-agent-mcp.ts --bundle --minify --legal-comments=eof --platform=node --format=esm --target=node20 --outfile=public/agent/opsv-agent-mcp.mjs && cp tools/opsv-agent-mcp.ts public/agent/opsv-agent-mcp.source.ts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:agent-mcp",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "security:check": "node tools/check-secrets.mjs && npm audit --omit=dev",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "postgres": "^3.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "type": "module"
}
