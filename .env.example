# OPSV Playground · projektstart 2026-08-24
# Kopiera filen till .env.local. Lägg aldrig riktiga värden i den här mallen.

# Publik kanonisk origin utan avslutande snedstreck.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://playground.opsv.dev

# PostgreSQL connection string (Vercel Postgres, Neon or compatible PostgreSQL).
DATABASE_URL=postgresql://user:password@host:5432/opsv?sslmode=require
# Valfri direktanslutning för migrationer hos leverantörer som erbjuder poolning.
DATABASE_URL_UNPOOLED=

# Discord Developer Portal → OAuth2 credentials. Never prefix these with NEXT_PUBLIC_.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Minst 32 slumpmässiga tecken. Generera exempelvis med: openssl rand -base64 32
AUTH_SECRET=
