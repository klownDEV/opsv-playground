# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files. The documented template is the only exception.
.env*
!.env.example

# vercel
.vercel

# Local agent/editor configuration
/.agents/
/.codex/
/.openai/
/AGENTS.md
/CLAUDE.md
/skills-lock.json
/opsv-playground-discord.jpg

# Generated MCP downloads (rebuilt by predev/prebuild)
/public/agent/opsv-agent-mcp.mjs
/public/agent/opsv-agent-mcp.source.ts

/dist/
/.wrangler/
/outputs/
/work/
